text: README.txt

clip {
    id: Actor
}

// Four RGB records: X, Y, velocity X, velocity Y. Alpha is not retained.
texture {
    id: Memory
    size: 4, 1
    source: Empty/
}
framebuffer {
    id: PreviousState
    size: 4, 1
    pos: 2, 0.5
    sprite {
        size: 4, 1
        source: Memory
    }
}

// The mask and visible actor use the same placement.
framebuffer {
    id: ActorMask
    size: 960, 540
    camera {
        type: 2D
        size: 960, 540
        clipSprite {
            pos: 480, 450
            standingHeight: 360
            sittingHeight: 300
            source: Actor, 0
            shader: fragment, mask.fsh
        }
    }
}
framebuffer {
    id: NextState
    size: 4, 1
    pos: 2, 0.5
    sprite {
        size: 4, 1
        source: PreviousState, 0
        source: ActorMask, 1
        shader: fragment, update.fsh
    }
}

camera {
    type: 2D
    size: 960, 540
    sprite {
        pos: 480, 270
        size: 960, 540
        hotspot: 0.5, 0.5
        source: NextState, 0
        shader: fragment, draw.fsh
        uniform: ballOnly, float, 0.0
        material: false
    }
    clipSprite {
        pos: 480, 450
        standingHeight: 360
        sittingHeight: 300
        source: Actor, 0
        blend: true
    }
    sprite {
        pos: 480, 270
        size: 960, 540
        hotspot: 0.5, 0.5
        source: NextState, 0
        shader: fragment, draw.fsh
        uniform: ballOnly, float, 1.0
        blend: true
        material: false
    }
    // Required for persistence: nothing may render after this sprite.
    sprite {
        opacity: 0.0
        source: NextState
    }
}
